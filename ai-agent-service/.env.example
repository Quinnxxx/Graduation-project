# ======================================================
# ai-agent-service 环境变量示例
# 使用方式：cp .env.example .env 后按需修改
# 禁止将真实密钥提交到版本仓库
# ======================================================

# ---- 应用 ----
APP_NAME=ai-agent-service
APP_ENV=dev
DEBUG=false
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=8001
LOG_LEVEL=INFO
# LOG_DIR=./logs

# ---- 大模型平台（阿里云百炼，OpenAI 兼容；DeepSeek 模型亦经本平台接入）----
# 阿里云百炼 API Key（统一管理所有模型）
DASHSCOPE_API_KEY=sk-your-aliyun-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 各 Agent 模型名（后期替换模型只需改这里）----
LLM_JOB_MODEL=qwen3.7-flash-2026-07-15
LLM_RESUME_MODEL=qwen3.7-flash-2026-07-15
LLM_TECH_MODEL=deepseek-v4-pro-0813
LLM_HR_MODEL=deepseek-v4-pro-0813
LLM_DEFAULT_MODEL=qwen3.7-flash-2026-07-15
# 大模型请求超时（秒），为复杂任务保留充足余量，默认 180
LLM_TIMEOUT=180

# ---- Embedding（向量化，RAG 检索）----
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=sk-your-aliyun-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 维度暂保留 1024，实测确认后回写
EMBEDDING_DIM=1024

# ---- Rerank（检索精排）----
RERANK_MODEL=qwen3.7-text-rerank
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# api_key 复用 DASHSCOPE_API_KEY，不新增密钥项

# ---- 业务服务内部调用（服务账号）----
SERVICE_USERNAME=admin
SERVICE_PASSWORD=123456

# ---- 对外对话接口内部鉴权 ----
# business-service 转发层的 ai.service.internal-token 必须与此一致；生产必须修改
AI_INTERNAL_TOKEN=campus-recruit-internal-token

# ---- Milvus v2.3.15 ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=campus_recruit_docs
MILVUS_USER_MEMORY_COLLECTION=campus_recruit_user_memory
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_ALIAS=default

# ---- Redis 7.2.4 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_SHORT_TERM_DB=1

# ---- 短期会话记忆参数 ----
SHORT_TERM_TTL=86400
SHORT_TERM_MAX_MESSAGES=20
MEMORY_STREAM_DISTILL=true

# ---- MySQL（长期记忆持久化骨架） ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=campus_recruit
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ---- 采集调度 ----
SCHEDULER_ENABLED=false
COLLECTOR_INTERVAL=3600

# ---- 业务服务 ----
BUSINESS_SERVICE_URL=http://localhost:8080

# ---- Timezone ----
TZ=Asia/Shanghai
