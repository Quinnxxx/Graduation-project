# ======================================================
# business-service 环境变量示例
# 使用方式：cp .env.example .env 后按需修改
# 禁止将真实密钥提交到版本仓库
# ======================================================

# ---- Server ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- MySQL 8.0.36 ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=campus_recruit
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ---- Redis 7.2.4 ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DATABASE=0

# ---- JWT（生产环境必须更换为强随机密钥，长度不小于32位） ----
JWT_SECRET=campus-recruit-ai-platform-jwt-secret-key-please-change-in-production
JWT_EXPIRATION=86400
JWT_HEADER=Authorization
JWT_PREFIX=Bearer

# ---- 内部接口鉴权（必须与 ai-agent-service 的 AI_INTERNAL_TOKEN 一致） ----
AI_SERVICE_INTERNAL_TOKEN=campus-recruit-internal-token

# ---- Timezone ----
TZ=Asia/Shanghai
